# DocuMind AI configuration.
# Copy this file to ".env" and adjust if needed. No API keys are required.

# Local Ollama service
OLLAMA_BASE_URL=http://localhost:11434

# Chat model. Lower-memory fallback: qwen3.5:2b
CHAT_MODEL=qwen3.5:4b

# Embedding model. Changing this requires a new COLLECTION_NAME (or deleting
# data/chroma) because vectors from different models must never be mixed.
EMBEDDING_MODEL=bge-m3

# Local ChromaDB storage (relative paths are resolved from the project root)
CHROMA_PATH=data/chroma
COLLECTION_NAME=documind_local

# Chunking (characters)
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Retrieval and generation
TOP_K=5
NUM_CTX=4096

# Upload limit per PDF
MAX_PDF_SIZE_MB=25
